# ─────────────────────────────────────────────────────────────
# Anjuman Admin — environment variables
# Copy this file to `.env.local` and fill in your values.
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# NEVER put a service_role key here.
# ─────────────────────────────────────────────────────────────

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public app URL (used for QR codes / ID card verification links)
NEXT_PUBLIC_APP_URL=https://anjuman.pages.dev

# Demo mode: if true (or if Supabase vars are empty), the app runs
# entirely on local mock data — useful for design review and demos.
NEXT_PUBLIC_DEMO_MODE=true
